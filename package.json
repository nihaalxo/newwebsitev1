{
  "name": "nihaalnazeer",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "check": "npm run typecheck --silent && next lint && node --import tsx scripts/check-content.ts && node --import tsx --test tests/*.test.ts",
    "preview": "npm run build && wrangler dev --port ${PORT:-4821}",
    "ci": "node scripts/ci.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && npm run types --silent && tsc -p worker --noEmit",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "content:format": "node --import tsx scripts/content-format.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "20.19.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "wrangler": "4.158.0"
  }
}
