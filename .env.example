# Optional. Copy to .env.development.local to point `npm run dev` somewhere else; a build needs none of these, because
# the defaults are the live addresses (and `npm run build` refuses pages that point at localhost).
#
# The admin's password is not an .env value: it goes in .dev.vars (see README.md), which `npm run dev` and
# `npm run preview` read. On Cloudflare it is a Worker secret (GO-LIVE.md, step 8).

# The site's own address, used for canonical links, the sitemap and share images.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where every Lair link goes (they open in a new tab); default https://interactive.nihaalnazeer.com/?film=on
# NEXT_PUBLIC_LAIR_URL=http://localhost:4700/?film=on&site=local

# Where uploads made in the live admin are served from; default https://media.nihaalnazeer.com
# NEXT_PUBLIC_MEDIA_ORIGIN=
