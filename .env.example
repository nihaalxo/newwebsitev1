# Copy to .env.local. With the Supabase values empty the site runs in local mode:
# content in .cms/content.json, uploads in public/uploads, admin login from ADMIN_EMAIL / ADMIN_PASSWORD.
# Local mode can only edit content while running `npm run dev`.

# --- Local mode (development) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Any long random string; signs the local admin session cookie.
LOCAL_SESSION_SECRET=replace-with-a-long-random-string

# --- Supabase mode (production) ---
# From your personal Supabase project: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by `npm run cms:push` on your own machine. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for share images and links.
NEXT_PUBLIC_SITE_URL=https://nihaalnazeer.com
