# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files: local addresses and keys, never committed
.env*.local

# The admin's email, password and session secret (read by `npm run dev` and `npm run preview`), wrangler's local
# D1/R2 state, and the OpenNext build
.dev.vars
.dev.vars.*
/.wrangler/
/.open-next/

# typescript
*.tsbuildinfo

# Local-mode content IS committed: .cms/content.json and public/uploads are the site's content until you move to
# Supabase. Only ignore the half-written files a crash mid-save or mid-upload could leave behind.
/.cms/*.tmp
/public/uploads/**/*.part
