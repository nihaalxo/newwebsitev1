// The site on Cloudflare: one Worker named nihaalnazeer, created by Workers Builds from the GitHub repository
// (GO-LIVE.md). Every page, image and font in out/ is a static asset, answered without running the Worker. The Worker
// runs only for the paths in run_worker_first: the films in public/ (to answer byte ranges, which Safari needs) and
// the admin's API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihaalnazeer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // /work serves work.html, and /work.html and /work/ redirect to /work.
    "html_handling": "auto-trailing-slash",
    // Any address the site doesn't have gets out/404.html with status 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/*.mp4", "/*.webm", "/*.mov", "/*.m4v"]
  },
  "r2_buckets": [
    // The admin's uploads, served to visitors at media.nihaalnazeer.com (a custom domain on the bucket).
    { "binding": "MEDIA", "bucket_name": "nihaalnazeer-media" },
    // The admin's drafts, the publish record, the build reports and the session key. Private.
    { "binding": "ADMIN", "bucket_name": "nihaalnazeer-admin" }
  ],
  "vars": {
    "GITHUB_REPO": "nihaalxo/newwebsitev1",
    "GITHUB_BRANCH": "main",
    "MEDIA_ORIGIN": "https://media.nihaalnazeer.com"
  },
  "observability": {
    "enabled": true
  }
  // Secrets, set in the dashboard (Settings > Variables and Secrets), never here: ADMIN_PASSWORD and GITHUB_TOKEN.
  // `npm run preview` reads them from .dev.vars. The custom domains are added in the dashboard (GO-LIVE.md).
}
