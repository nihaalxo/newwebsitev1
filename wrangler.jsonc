// The Cloudflare Worker that serves the site, built by OpenNext (`npm run cf:build`, `npm run deploy`).
// GO-LIVE.md walks through creating the database and bucket, the secrets and the custom domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihaalnazeer",
  // cloudflare/worker.mjs hands every request to the site OpenNext builds into .open-next/worker.js, and serves the
  // films in public/ with byte ranges, which Safari needs to play them.
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Everything in public/ plus Next's static files, served before the Worker runs. Films go to the Worker first, so
  // a Range request gets 206 and the requested bytes (static assets alone answer 200 with the whole file).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/*.mp4", "/*.webm", "/*.mov", "/*.m4v"],
    // Files only at their exact path, as Next serves public/ (OpenNext requires this with run_worker_first).
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Lets the Worker call itself (OpenNext uses it for revalidation).
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nihaalnazeer"
    }
  ],
  // Projects and site settings. Replace database_id with the id `npx wrangler d1 create nihaalnazeer-cms` prints.
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "nihaalnazeer-cms",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "d1/migrations"
    }
  ],
  // Images, films and the CV uploaded in the admin, served at /cms/...
  "r2_buckets": [
    {
      "binding": "CMS_UPLOADS",
      "bucket_name": "nihaalnazeer-uploads"
    }
  ],
  "observability": {
    "enabled": true
  }
  // The custom domain is attached in step 10 of GO-LIVE.md. ADMIN_EMAIL, ADMIN_PASSWORD and LOCAL_SESSION_SECRET are
  // secrets (`npx wrangler secret put NAME`, step 5), never vars in this file; the local preview reads them from .dev.vars.
}
